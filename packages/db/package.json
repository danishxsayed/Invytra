{
  "name": "@invytra/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "node --env-file=../../.env ./node_modules/prisma/build/index.js migrate dev",
    "studio": "node --env-file=../../.env ./node_modules/prisma/build/index.js studio",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "prisma": "node --env-file=../../.env ./node_modules/prisma/build/index.js",
    "migrate:deploy": "node --env-file=../../.env ./node_modules/prisma/build/index.js migrate deploy",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/caveat": "5.1.1",
    "@fontsource/kalam": "5.1.1",
    "@fontsource/patrick-hand": "5.1.1",
    "@prisma/client": "6.1.0",
    "@resvg/resvg-js": "2.6.2",
    "imapflow": "1.0.171",
    "jose": "5.9.6",
    "mailparser": "3.7.1",
    "nodemailer": "6.9.16",
    "opentype.js": "1.3.4",
    "satori": "0.12.2"
  },
  "devDependencies": {
    "@types/mailparser": "3.4.5",
    "@types/node": "22.10.2",
    "@types/nodemailer": "6.4.17",
    "@types/opentype.js": "1.3.8",
    "prisma": "6.1.0",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
