// Invytra schema.
// Phase 1: multi-tenant. Every tenant table carries workspace_id, and the web app
// always filters by the signed-in user's workspace.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberRole {
  OWNER
  MEMBER
}

/// A customer (company). Everything a customer owns hangs off a workspace.
model Workspace {
  id            String    @id @default(cuid())
  name          String
  plan          String    @default("trial")
  /// Outreach channels this workspace's subscription includes (ids from CHANNELS in @invytra/shared)
  channels      String[]  @default(["linkedin", "email"])
  /// Email verification credits: used this credit month (verifyPeriod = its 1st, UTC), and
  /// extra credits bought (never expire). The monthly allowance comes from the plan.
  verifyUsed    Int       @default(0) @map("verify_used")
  verifyPeriod  DateTime? @map("verify_period")
  verifyExtra   Int       @default(0) @map("verify_extra")
  /// AI credits (one balance for every AI feature on every channel), same idea as above.
  aiUsed        Int       @default(0) @map("ai_used")
  aiPeriod      DateTime? @map("ai_period")
  aiExtra       Int       @default(0) @map("ai_extra")
  /// Monthly allowances, set by the plan (see Subscription): AI credits and verification credits
  aiMonthly     Int       @default(20) @map("ai_monthly")
  verifyMonthly Int       @default(100) @map("verify_monthly")
  createdAt     DateTime  @default(now()) @map("created_at")

  members            Membership[]
  accounts           LinkedinAccount[]
  leadLists          LeadList[]
  imports            LeadImport[]
  leads              Lead[]
  campaigns          Campaign[]
  mailboxes          EmailAccount[]
  emailCampaigns     EmailCampaign[]
  emailContacts      EmailContact[]
  emailLists         EmailList[]
  emailVariables     EmailVariable[]
  emailSuppressions  EmailSuppression[]
  verifyPurchases    VerifyCreditPurchase[]
  aiUsage            AiCreditUse[]
  voices             VoiceClone[]
  videos             VideoRecording[]
  invySearches       InvySearch[]
  invyProspects      InvyProspect[]
  billingProfile     BillingProfile?
  subscription       Subscription?
  subscriptionEvents SubscriptionEvent[]
  planCheckouts      PlanCheckout[]
  doNotContact       DoNotContact[]
  people             Person[]
  WorkspaceInvite    WorkspaceInvite[]
  whatsappNumbers    WhatsappNumber[]
  whatsappTemplates  WhatsappTemplate[]
  whatsappContacts   WhatsappContact[]

  @@map("workspaces")
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String
  /// bcrypt hash. Never log or return this.
  passwordHash       String    @map("password_hash")
  createdAt          DateTime  @default(now()) @map("created_at")
  lastLoginAt        DateTime? @map("last_login_at")
  /// Sessions signed before this moment are no longer accepted (password change, "sign out everywhere")
  sessionsValidAfter DateTime? @map("sessions_valid_after")
  /// Answers to the questions after sign-up (onboardingSchema in @invytra/shared); null = not asked yet
  onboarding         Json?
  /// When they finished (or skipped) those questions
  onboardedAt        DateTime? @map("onboarded_at")

  memberships    Membership[]
  passwordResets PasswordReset[]

  @@map("users")
}

model Membership {
  userId      String     @map("user_id")
  workspaceId String     @map("workspace_id")
  role        MemberRole @default(MEMBER)
  createdAt   DateTime   @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
  @@index([workspaceId])
  @@map("memberships")
}

enum AccountStatus {
  ACTIVE
  PAUSED
  NEEDS_ATTENTION // checkpoint, captcha, restriction or invalid session — a human must look
  DISCONNECTED
}

enum ActionType {
  PROFILE_VISIT
  CONNECTION_REQUEST
  CHECK_CONNECTION
  MESSAGE
  INBOX_SYNC
  /// Reads one page of a LinkedIn / Sales Navigator search into a lead list
  SEARCH_PAGE
  /// Likes the person's most recent post
  LIKE_POST
  /// Withdraws a pending invitation
  WITHDRAW_INVITE
  /// A reply typed by the user in Invytra's inbox
  REPLY
  /// Follows the person's profile
  FOLLOW_PROFILE
  /// Likes and comments on the person's most recent post
  COMMENT_POST
  /// Invites a connection to one of your LinkedIn events
  EVENT_INVITE
}

enum ImportKind {
  LINKEDIN_SEARCH
  SALES_NAV_SEARCH
  SALES_NAV_LIST
}

enum ImportStatus {
  RUNNING
  DONE
  FAILED
  CANCELLED
}

enum ActionStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED // blocked by limits/hours and not retried
}

/// How Invytra talks to LinkedIn for an account.
enum ConnectionEngine {
  /// Invytra's own browser, through the account's proxy
  BROWSER
  /// Unipile's API (Unipile provides the login page and the IP)
  UNIPILE
}

model LinkedinAccount {
  id               String           @id @default(cuid())
  /// Accounts from .env (Phase 0 CLI) live in the "default" workspace.
  workspaceId      String           @default("default") @map("workspace_id")
  label            String
  email            String?
  proxyUrl         String           @map("proxy_url")
  timezone         String           @default("Asia/Kolkata")
  status           AccountStatus    @default(ACTIVE)
  /// AES-256-GCM encrypted Playwright storage state. Never log this.
  encryptedSession Bytes?           @map("encrypted_session")
  sessionUpdatedAt DateTime?        @map("session_updated_at")
  /// { days: number[], startHour: number, endHour: number } — validated by @invytra/shared
  workingHours     Json             @map("working_hours")
  /// Limits object — validated by @invytra/shared limitsSchema
  limits           Json
  statusReason     String?          @map("status_reason")
  lastActiveAt     DateTime?        @map("last_active_at")
  /// Read from LinkedIn after connecting (the person's display name and profile link)
  profileName      String?          @map("profile_name")
  profileUrl       String?          @map("profile_url")
  /// Whether this LinkedIn account has Premium, as last detected (null = not known yet)
  premium          Boolean?
  premiumCheckedAt DateTime?        @map("premium_checked_at")
  /// The account's own LinkedIn profile photo (small image, read when it connects and about weekly)
  avatar           Bytes?
  avatarType       String?          @map("avatar_type")
  avatarUpdatedAt  DateTime?        @map("avatar_updated_at")
  engine           ConnectionEngine @default(BROWSER)
  /// The account's id at Unipile (engine UNIPILE)
  unipileAccountId String?          @unique @map("unipile_account_id")
  /// When the latest Unipile login was opened (to recognise the account it creates)
  unipileLinkAt    DateTime?        @map("unipile_link_at")
  /// Not used (the plan is always detected); kept so older data still loads
  premiumOverride  Boolean?         @map("premium_override")
  /// First successful connection through the dashboard or CLI
  connectedAt      DateTime?        @map("connected_at")
  /// Daily limits ramp up until this time (new accounts); null = no warm-up
  warmupUntil      DateTime?        @map("warmup_until")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actions         Action[]
  messages        InboxMessage[]
  campaignSenders CampaignSender[]
  campaignLeads   CampaignLead[]
  imports         LeadImport[]
  conversations   Conversation[]

  @@unique([workspaceId, label])
  @@index([workspaceId])
  @@map("linkedin_accounts")
}

model Action {
  id             String       @id @default(cuid())
  accountId      String       @map("account_id")
  type           ActionType
  targetUrl      String?      @map("target_url")
  /// Action input, e.g. { note } for invites or { text } for messages
  payload        Json?
  status         ActionStatus @default(QUEUED)
  error          String?
  screenshotPath String?      @map("screenshot_path")
  attempts       Int          @default(0)
  scheduledAt    DateTime     @default(now()) @map("scheduled_at")
  executedAt     DateTime?    @map("executed_at")
  durationMs     Int?         @map("duration_ms")
  createdAt      DateTime     @default(now()) @map("created_at")
  /// Set when a campaign queued this action for one of its leads
  campaignLeadId String?      @map("campaign_lead_id")
  /// For a REPLY: the inbox message it answers (older replies)
  inboxMessageId String?      @map("inbox_message_id")
  /// For a REPLY: the conversation it's sent in
  conversationId String?      @map("conversation_id")

  account      LinkedinAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  campaignLead CampaignLead?   @relation(fields: [campaignLeadId], references: [id], onDelete: SetNull)
  inboxMessage InboxMessage?   @relation(fields: [inboxMessageId], references: [id], onDelete: SetNull)
  conversation Conversation?   @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  // Daily/weekly limit counting: actions per account, type and time window
  @@index([accountId, type, status, executedAt])
  @@index([status, scheduledAt])
  // Lead status: what happened to a profile
  @@index([targetUrl])
  @@index([campaignLeadId])
  @@index([inboxMessageId])
  @@index([conversationId])
  @@map("actions")
}

/// Replies fetched by INBOX_SYNC. Deduplicated per account by LinkedIn message id.
model InboxMessage {
  id                String    @id @default(cuid())
  accountId         String    @map("account_id")
  linkedinMessageId String    @map("linkedin_message_id")
  fromName          String    @map("from_name")
  fromProfileUrl    String?   @map("from_profile_url")
  text              String
  sentAt            DateTime  @map("sent_at")
  fetchedAt         DateTime  @default(now()) @map("fetched_at")
  /// The campaign lead this reply is from (matched by name; LinkedIn's inbox list has no profile links)
  campaignLeadId    String?   @map("campaign_lead_id")
  /// Marked handled in Invytra
  doneAt            DateTime? @map("done_at")
  /// A later inbox read showed our own message as the latest in that conversation
  answeredAt        DateTime? @map("answered_at")

  account      LinkedinAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  campaignLead CampaignLead?   @relation(fields: [campaignLeadId], references: [id], onDelete: SetNull)
  /// Replies sent from Invytra's inbox
  replies      Action[]

  @@unique([accountId, linkedinMessageId])
  @@index([accountId, sentAt])
  @@index([accountId, fetchedAt])
  @@index([campaignLeadId])
  @@map("inbox_messages")
}

/// A named list of people to reach out to (CSV upload or pasted links).
model LeadList {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leads     Lead[]
  campaigns Campaign[]
  imports   LeadImport[]

  @@index([workspaceId])
  @@map("lead_lists")
}

/// One person in a list. profileUrl is canonical (https://www.linkedin.com/in/<slug>/),
/// the same form the worker stores in actions.target_url.
model Lead {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  listId      String   @map("list_id")
  profileUrl  String   @map("profile_url")
  firstName   String?  @map("first_name")
  lastName    String?  @map("last_name")
  company     String?
  title       String?
  location    String?
  /// Connection degree seen on LinkedIn (1, 2, 3 = 3rd+), from a search import or a profile visit
  degree      Int?
  /// LinkedIn Premium badge seen (null = not known yet)
  premium     Boolean?
  /// Email from their LinkedIn contact info (only visible once they're a 1st-degree connection)
  email       String?
  /// Their LinkedIn profile photo (LinkedIn's own link; it expires after a while and is refreshed
  /// whenever the profile is seen again)
  photoUrl    String?  @map("photo_url")
  /// Other columns from the uploaded file, for personalisation later
  extra       Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  /// The workspace contact this person is (linked by the contacts sync)
  personId    String?  @map("person_id")

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  list          LeadList       @relation(fields: [listId], references: [id], onDelete: Cascade)
  campaignLeads CampaignLead[]
  person        Person?        @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@unique([listId, profileUrl])
  @@index([workspaceId, profileUrl])
  @@index([personId])
  @@index([listId, createdAt])
  @@map("leads")
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum CampaignLeadState {
  QUEUED
  IN_PROGRESS
  WAITING_ACCEPT
  DONE
  REPLIED
  NOT_ACCEPTED
  SKIPPED
  FAILED
  /// Paused by you (e.g. you took over the conversation); reason holds the state to resume to
  PAUSED
}

/// One LinkedIn account working through one lead list with a sequence of steps.
model Campaign {
  id            String         @id @default(cuid())
  workspaceId   String         @map("workspace_id")
  name          String
  /// Leads added to this list later join the running campaign.
  listId        String?        @map("list_id")
  status        CampaignStatus @default(DRAFT)
  /// CampaignStep[] — validated by @invytra/shared sequenceSchema
  steps         Json
  /// CampaignSettings — @invytra/shared campaignSettingsSchema
  settings      Json           @default("{}")
  startedAt     DateTime?      @map("started_at")
  /// Last time leads were copied in from the list (re-copied when the list changes)
  leadsSyncedAt DateTime?      @map("leads_synced_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  list      LeadList?        @relation(fields: [listId], references: [id], onDelete: SetNull)
  leads     CampaignLead[]
  /// The LinkedIn accounts sending for this campaign. Leads are shared out between them.
  senders   CampaignSender[]

  @@index([workspaceId])
  @@index([status])
  @@map("campaigns")
}

/// One person's progress through a campaign. Lead details are copied in, so
/// deleting the list doesn't break a running campaign.
model CampaignLead {
  id           String            @id @default(cuid())
  campaignId   String            @map("campaign_id")
  workspaceId  String            @map("workspace_id")
  leadId       String?           @map("lead_id")
  /// The sender this lead belongs to for its whole journey (a LinkedIn connection is per account).
  /// Assigned when the lead starts; null until then, or if that account was deleted.
  accountId    String?           @map("account_id")
  profileUrl   String            @map("profile_url")
  firstName    String?           @map("first_name")
  lastName     String?           @map("last_name")
  company      String?
  title        String?
  /// The name LinkedIn shows — used to match replies in the inbox
  linkedinName String?           @map("linkedin_name")
  /// Connection degree (1, 2, 3 = 3rd+) and Premium badge, as last seen; used by the campaign's audience settings
  degree       Int?
  premium      Boolean?
  /// The AI personalisation line written for this person ({aiLine}), what it was based on, and when
  aiLine       String?           @map("ai_line")
  aiSignal     String?           @map("ai_signal")
  aiLineAt     DateTime?         @map("ai_line_at")
  state        CampaignLeadState @default(QUEUED)
  /// Index of the next step to run
  step         Int               @default(0)
  nextAt       DateTime?         @map("next_at")
  /// The queued/running action for this lead, if any
  actionId     String?           @map("action_id")
  /// Why it was skipped / failed / not accepted (a code the dashboard explains)
  reason       String?
  invitedAt    DateTime?         @map("invited_at")
  connectedAt  DateTime?         @map("connected_at")
  /// First message sent by this campaign
  messagedAt   DateTime?         @map("messaged_at")
  repliedAt    DateTime?         @map("replied_at")
  lastActionAt DateTime?         @map("last_action_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  campaign Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead     Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  actions  Action[]
  replies  InboxMessage[]
  account  LinkedinAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  conversations Conversation[]

  @@unique([campaignId, profileUrl])
  @@index([campaignId, state, nextAt])
  @@index([workspaceId, profileUrl])
  @@index([accountId, state])
  @@map("campaign_leads")
}

/// One LinkedIn account sending for one campaign.
model CampaignSender {
  campaignId String   @map("campaign_id")
  accountId  String   @map("account_id")
  createdAt  DateTime @default(now()) @map("created_at")

  campaign Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  account  LinkedinAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([campaignId, accountId])
  @@index([accountId])
  @@map("campaign_senders")
}

/// Collecting people from a LinkedIn or Sales Navigator search into a lead list,
/// one results page per queued SEARCH_PAGE action (CLAUDE.md rule 1).
model LeadImport {
  id          String       @id @default(cuid())
  workspaceId String       @map("workspace_id")
  listId      String       @map("list_id")
  /// The LinkedIn account whose browser reads the search
  accountId   String       @map("account_id")
  kind        ImportKind
  url         String
  status      ImportStatus @default(RUNNING)
  /// Stop after this many people
  maxLeads    Int          @default(500) @map("max_leads")
  /// Next results page to read (1-based)
  nextPage    Int          @default(1) @map("next_page")
  pages       Int          @default(0)
  /// People seen on the pages read so far, and how many were new to the list
  found       Int          @default(0)
  added       Int          @default(0)
  /// The queued/running SEARCH_PAGE action, if any
  actionId    String?      @map("action_id")
  /// Why it stopped (a code the dashboard explains)
  reason      String?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  finishedAt  DateTime?    @map("finished_at")

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  list      LeadList        @relation(fields: [listId], references: [id], onDelete: Cascade)
  account   LinkedinAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([status])
  @@map("lead_imports")
}

/// One LinkedIn conversation of an account, as the inbox shows it. Keyed by the other
/// person's name (LinkedIn's conversation list has no profile links).
model Conversation {
  id              String    @id @default(cuid())
  accountId       String    @map("account_id")
  participantName String    @map("participant_name")
  /// The chat's id at Unipile (accounts connected through Unipile), to reply in the same chat
  externalId      String?   @map("external_id")
  /// The campaign lead this is with (matched by name)
  campaignLeadId  String?   @map("campaign_lead_id")
  /// Fingerprint of the latest snippet seen in the conversation list (to spot changes)
  lastSnippetKey  String?   @map("last_snippet_key")
  lastMessageText String    @default("") @map("last_message_text")
  /// The latest message is ours
  lastFromMe      Boolean   @default(false) @map("last_from_me")
  lastMessageAt   DateTime  @default(now()) @map("last_message_at")
  /// LinkedIn showed it as unread at the last inbox check
  unread          Boolean   @default(false)
  /// Marked handled in Invytra (cleared when they write again)
  doneAt          DateTime? @map("done_at")
  tags            String[]  @default([])
  /// When it was tagged "Meeting booked" (cleared when the tag is removed): counted on the overview
  meetingAt       DateTime? @map("meeting_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  account      LinkedinAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  campaignLead CampaignLead?         @relation(fields: [campaignLeadId], references: [id], onDelete: SetNull)
  messages     ConversationMessage[]
  replies      Action[]

  @@unique([accountId, participantName])
  @@index([accountId, lastMessageAt])
  @@index([campaignLeadId])
  @@map("conversations")
}

/// One message in a conversation, as read from LinkedIn (or sent from Invytra).
model ConversationMessage {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  fromMe         Boolean  @map("from_me")
  text           String
  /// What LinkedIn showed, e.g. "Oct 18 · 12:15 PM"
  timeLabel      String?  @map("time_label")
  /// Best-known time (parsed from LinkedIn, or when Invytra first saw it)
  sentAt         DateTime @map("sent_at")
  /// Side + text + nth repeat: the same message read twice is stored once
  key            String
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, key])
  @@index([conversationId, sentAt])
  @@map("conversation_messages")
}

enum MailboxProvider {
  GOOGLE
  MICROSOFT
  ZOHO
  HOSTINGER
  GODADDY
  OTHER
}

enum MailboxStatus {
  ACTIVE
  ERROR
  PAUSED
}

/// A sending mailbox on the customer's own domain (Email Outreach), connected with SMTP to
/// send and IMAP to read replies. One mailbox is on Invytra once.
model EmailAccount {
  id               String          @id @default(cuid())
  workspaceId      String          @map("workspace_id")
  /// Lower-case address, e.g. tahur@getcrawlers.com
  email            String          @unique
  fromName         String          @map("from_name")
  provider         MailboxProvider
  smtpHost         String          @map("smtp_host")
  smtpPort         Int             @map("smtp_port")
  /// true = TLS from the start (465); false = STARTTLS (587)
  smtpSecure       Boolean         @map("smtp_secure")
  imapHost         String          @map("imap_host")
  imapPort         Int             @map("imap_port")
  /// Login name (usually the address itself)
  username         String
  /// The (app) password, AES-256-GCM encrypted with SESSION_ENCRYPTION_KEY. Never logged.
  secret           String
  status           MailboxStatus   @default(ACTIVE)
  /// Why it stopped working (a short, plain message)
  statusReason     String?         @map("status_reason")
  /// Emails it may send a day (warm-up raises it over time)
  dailyLimit       Int             @default(30) @map("daily_limit")
  /// Minutes between two emails from this mailbox
  gapMinutes       Int             @default(6) @map("gap_minutes")
  /// Sending hours: days (1 = Monday … 7 = Sunday) and hours in this IANA time zone
  timeZone         String          @default("UTC") @map("time_zone")
  sendDays         Int[]           @default([1, 2, 3, 4, 5]) @map("send_days")
  startHour        Int             @default(9) @map("start_hour")
  endHour          Int             @default(18) @map("end_hour")
  /// Plain-text signature added under every email
  signature        String          @default("")
  lastSentAt       DateTime?       @map("last_sent_at")
  /// Warm-up: in the pool, since when (the ramp counts from here), up to how many a day,
  /// and the % of received warm-up emails it replies to
  warmupEnabled    Boolean         @default(false) @map("warmup_enabled")
  warmupStartedAt  DateTime?       @map("warmup_started_at")
  warmupMaxDaily   Int             @default(20) @map("warmup_max_daily")
  warmupReplyRate  Int             @default(30) @map("warmup_reply_rate")
  lastWarmupAt     DateTime?       @map("last_warmup_at")
  /// Campaign sending waits until then (the gap plus a random extra)
  nextSendAt       DateTime?       @map("next_send_at")
  /// Reply reading: the IMAP inbox's UIDVALIDITY and the next UID not yet read
  replyUidValidity BigInt?         @map("reply_uid_validity")
  replyUidNext     Int?            @map("reply_uid_next")
  /// Why reading the inbox last failed (null = it worked)
  replyError       String?         @map("reply_error")
  lastReplyCheckAt DateTime?       @map("last_reply_check_at")
  lastCheckedAt    DateTime?       @map("last_checked_at")
  /// The domain's email DNS (SPF, DKIM, DMARC, MX) as last checked (DomainDns in @invytra/db)
  dns              Json?
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  workspace Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sends     EmailSend[]
  received  EmailSend[]            @relation("WarmupReceived")
  campaigns EmailCampaignMailbox[]
  leads     EmailLead[]
  replies   EmailReply[]

  @@index([workspaceId])
  @@map("email_accounts")
}

enum EmailSendKind {
  TEST
  CAMPAIGN
  WARMUP
  /// Written in the inbox, answering a lead
  REPLY
}

enum EmailSendStatus {
  SENT
  FAILED
}

/// Where a warm-up email landed in the receiving mailbox
enum WarmupLanding {
  INBOX
  SPAM
  MISSING
}

/// Every email a mailbox tried to send: what counts toward its daily limit, and the log.
model EmailSend {
  id             String          @id @default(cuid())
  workspaceId    String          @map("workspace_id")
  emailAccountId String          @map("email_account_id")
  kind           EmailSendKind
  status         EmailSendStatus
  toEmail        String          @map("to_email")
  subject        String
  /// The SMTP Message-ID (to match replies later)
  messageId      String?         @map("message_id")
  error          String?
  /// What was sent (campaign emails and inbox replies, with the signature)
  text           String?
  /// Campaign and inbox replies: the lead; campaign: which email of the sequence (0 = the first)
  emailLeadId    String?         @map("email_lead_id")
  stepIndex      Int?            @map("step_index")
  /// Warm-up only: the pool mailbox it went to, the code that finds it there, whether it is
  /// a reply (replies get no reply), where it landed and when that was checked
  toAccountId    String?         @map("to_account_id")
  warmupCode     String?         @unique @map("warmup_code")
  isReply        Boolean         @default(false) @map("is_reply")
  landedIn       WarmupLanding?  @map("landed_in")
  checkedAt      DateTime?       @map("checked_at")
  createdAt      DateTime        @default(now()) @map("created_at")

  emailAccount EmailAccount  @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  toAccount    EmailAccount? @relation("WarmupReceived", fields: [toAccountId], references: [id], onDelete: Cascade)
  emailLead    EmailLead?    @relation(fields: [emailLeadId], references: [id], onDelete: SetNull)

  @@index([emailAccountId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([kind, landedIn, createdAt])
  @@index([emailLeadId])
  @@map("email_sends")
}

/// Shown as: Draft, Scheduled, Sending (ACTIVE), Paused, Sent (COMPLETED), Cancelled
enum EmailCampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

/// An email campaign: leads, a sequence of emails (steps JSON, EmailStep[] in @invytra/shared)
/// and the mailboxes that send it.
model EmailCampaign {
  id                  String              @id @default(cuid())
  workspaceId         String              @map("workspace_id")
  name                String
  status              EmailCampaignStatus @default(DRAFT)
  steps               Json                @default("[]")
  /// Variable names from the imported CSV columns (beyond the built-in ones)
  columns             String[]            @default([])
  /// Unsubscribe: show the link in emails (the one-click header is always sent), and its text;
  /// [brackets] mark the linked words, {{unsubscribe}} in an email places it
  unsubscribeLink     Boolean             @default(true) @map("unsubscribe_link")
  unsubscribeText     String              @default("Don't want to receive these emails anymore? [Unsubscribe here]") @map("unsubscribe_text")
  /// Soft bounces (mailbox full, server busy): try the same email again this many times, this many hours apart
  softBounceRetries   Int                 @default(2) @map("soft_bounce_retries")
  softRetryHours      Int                 @default(24) @map("soft_retry_hours")
  /// Scheduled sending: the first emails go out from this moment (the earliest, when each
  /// recipient's own time zone is used), as entered (local date-time + zone)
  scheduledAt         DateTime?           @map("scheduled_at")
  scheduleLocal       String?             @map("schedule_local")
  scheduleTimeZone    String?             @map("schedule_time_zone")
  scheduleRecipientTz Boolean             @default(false) @map("schedule_recipient_tz")
  launchedAt          DateTime?           @map("launched_at")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  workspace Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mailboxes EmailCampaignMailbox[]
  leads     EmailLead[]

  @@index([workspaceId])
  @@index([status])
  @@map("email_campaigns")
}

model EmailCampaignMailbox {
  campaignId     String @map("campaign_id")
  emailAccountId String @map("email_account_id")

  campaign     EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  emailAccount EmailAccount  @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)

  @@id([campaignId, emailAccountId])
  @@map("email_campaign_mailboxes")
}

enum EmailLeadStatus {
  /// Still has emails to send
  ACTIVE
  /// Every email was sent, no reply
  COMPLETED
  REPLIED
  BOUNCED
  /// Couldn't be written (a variable with no value) or other stop; see reason
  SKIPPED
  UNSUBSCRIBED
}

model EmailLead {
  id              String          @id @default(cuid())
  workspaceId     String          @map("workspace_id")
  campaignId      String          @map("campaign_id")
  /// The workspace contact this lead is (statuses: subscribed, bounced, verified)
  contactId       String?         @map("contact_id")
  email           String
  firstName       String?         @map("first_name")
  lastName        String?         @map("last_name")
  company         String?
  title           String?
  website         String?
  /// Other CSV columns: { variableName: value }
  vars            Json            @default("{}")
  status          EmailLeadStatus @default(ACTIVE)
  /// The next email of the sequence to send (0 = the first)
  stepIndex       Int             @default(0) @map("step_index")
  /// When the next email is due (null = not scheduled: draft, or done)
  nextAt          DateTime?       @map("next_at")
  /// The mailbox that writes to this lead (all its emails come from the same one)
  emailAccountId  String?         @map("email_account_id")
  /// The first email's Message-ID and subject, so follow-ups thread under it
  threadMessageId String?         @map("thread_message_id")
  threadSubject   String?         @map("thread_subject")
  reason          String?
  /// HARD | SOFT, when the lead bounced; soft bounces so far (retried up to the campaign's limit)
  bounceType      String?         @map("bounce_type")
  softBounces     Int             @default(0) @map("soft_bounces")
  lastSentAt      DateTime?       @map("last_sent_at")
  repliedAt       DateTime?       @map("replied_at")
  /// Inbox: marked done (until they write again)
  inboxDoneAt     DateTime?       @map("inbox_done_at")
  /// When a meeting was booked with them (marked in the inbox): counted on the overview
  meetingAt       DateTime?       @map("meeting_at")
  createdAt       DateTime        @default(now()) @map("created_at")

  campaign     EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact      EmailContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  emailAccount EmailAccount? @relation(fields: [emailAccountId], references: [id], onDelete: SetNull)
  sends        EmailSend[]
  replies      EmailReply[]

  @@unique([campaignId, email])
  @@index([campaignId, status, nextAt])
  @@index([workspaceId, email])
  @@map("email_leads")
}

/// A message that arrived in a campaign mailbox from a lead: a reply, auto-reply or bounce.
model EmailReply {
  id             String    @id @default(cuid())
  workspaceId    String    @map("workspace_id")
  emailAccountId String    @map("email_account_id")
  emailLeadId    String?   @map("email_lead_id")
  /// REPLY | AUTO_REPLY | BOUNCE
  kind           String
  fromEmail      String    @map("from_email")
  fromName       String?   @map("from_name")
  subject        String
  /// The text of the message (quoted history trimmed), at most a few thousand characters
  text           String
  messageId      String?   @map("message_id")
  receivedAt     DateTime  @map("received_at")
  /// Seen in the dashboard
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  emailAccount EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  emailLead    EmailLead?   @relation(fields: [emailLeadId], references: [id], onDelete: SetNull)

  @@unique([emailAccountId, messageId])
  @@index([workspaceId, receivedAt])
  @@map("email_replies")
}

enum EmailBounceStatus {
  NONE
  /// Temporary (mailbox full, server busy): retried a few times
  SOFT
  /// Permanent (no such address): never emailed again
  HARD
}

enum EmailVerification {
  NOT_CHECKED
  PENDING
  VALID
  INVALID
  RISKY
  UNKNOWN
}

/// A person the workspace can email: one row per address, shared by lists and campaigns.
model EmailContact {
  id             String            @id @default(cuid())
  workspaceId    String            @map("workspace_id")
  email          String
  firstName      String?           @map("first_name")
  lastName       String?           @map("last_name")
  company        String?
  title          String?
  website        String?
  /// Custom variables: { key: value }
  vars           Json              @default("{}")
  subscribed     Boolean           @default(true)
  unsubscribedAt DateTime?         @map("unsubscribed_at")
  bounceStatus   EmailBounceStatus @default(NONE) @map("bounce_status")
  softBounces    Int               @default(0) @map("soft_bounces")
  lastBounceAt   DateTime?         @map("last_bounce_at")
  bounceReason   String?           @map("bounce_reason")
  verification   EmailVerification @default(NOT_CHECKED)
  verifiedAt     DateTime?         @map("verified_at")
  /// The verifier's own words (e.g. "catch-all", "disposable", "mailbox not found")
  verifyDetail   String?           @map("verify_detail")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  /// The workspace contact this address belongs to (linked by the contacts sync)
  personId String? @map("person_id")

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lists     EmailListMember[]
  leads     EmailLead[]
  person    Person?           @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([personId])
  @@index([workspaceId, verification])
  @@map("email_contacts")
}

model EmailList {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   EmailListMember[]

  @@unique([workspaceId, name])
  @@map("email_lists")
}

model EmailListMember {
  listId    String   @map("list_id")
  contactId String   @map("contact_id")
  addedAt   DateTime @default(now()) @map("added_at")

  list    EmailList    @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact EmailContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([listId, contactId])
  @@index([contactId])
  @@map("email_list_members")
}

/// A custom variable the workspace uses in emails ({{key}}), from a CSV column or made by hand.
model EmailVariable {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  /// snake_case, e.g. pain_point
  key         String
  label       String
  /// Used when a contact has no value (empty = such contacts are skipped)
  fallback    String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@map("email_variables")
}

enum SuppressionReason {
  UNSUBSCRIBED
  HARD_BOUNCE
  COMPLAINT
  MANUAL
}

/// Addresses the workspace never emails (campaigns skip them; imports flag them).
model EmailSuppression {
  id          String            @id @default(cuid())
  workspaceId String            @map("workspace_id")
  email       String
  reason      SuppressionReason
  detail      String?
  createdAt   DateTime          @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@map("email_suppressions")
}

/// "Forgot password?" links: only a hash of the token is stored; one use, short-lived.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  /// sha256 of the token in the emailed link
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_resets")
}

enum VerifyPurchaseStatus {
  PENDING
  PAID
  CANCELLED
}

enum CreditKind {
  VERIFY
  AI
  /// A plan payment (subscription, renewal or upgrade): credits 0, description says what
  PLAN
}

/// Extra credits a workspace bought (or asked to buy): email verification or AI.
model VerifyCreditPurchase {
  id                String               @id @default(cuid())
  workspaceId       String               @map("workspace_id")
  kind              CreditKind           @default(VERIFY)
  credits           Int
  priceCents        Int                  @map("price_cents")
  currency          String               @default("USD")
  status            VerifyPurchaseStatus @default(PENDING)
  /// Who asked (user id), and the payment's reference once paid
  requestedBy       String?              @map("requested_by")
  paymentRef        String?              @map("payment_ref")
  createdAt         DateTime             @default(now()) @map("created_at")
  paidAt            DateTime?            @map("paid_at")
  /// The Razorpay order this payment goes through (null: paid by hand / before Razorpay)
  razorpayOrderId   String?              @unique @map("razorpay_order_id")
  /// How it was paid, as Razorpay reports it (card, upi, netbanking …)
  method            String?
  /// Given when it's paid: INV-<year>-<number>, one sequence for all workspaces
  invoiceNumber     String?              @unique @map("invoice_number")
  /// Who it was billed to and by, frozen when paid (later edits to billing details don't change it)
  invoice           Json?
  /// Plan payments: what it was for ("Growth plan, monthly: Nov 13 – Dec 13, 2026")
  description       String?
  /// The Razorpay payment (plan renewals: one invoice per payment, even if Razorpay tells us twice)
  razorpayPaymentId String?              @unique @map("razorpay_payment_id")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("verify_credit_purchases")
}

/// One use of AI credits (what used them, how many), for the usage list on the Credits page.
model AiCreditUse {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  /// TEXT | NOTE | HANDWRITTEN | VOICE | VIDEO (AI_COSTS in @invytra/shared)
  action      String
  credits     Int
  /// Where it was used (campaign or lead id), when known
  ref         String?
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("ai_credit_uses")
}

/// A voice copied from a recording of the customer (for voice notes). The recording itself isn't
/// kept: it goes to the voice provider, which keeps the copy under providerVoiceId.
model VoiceClone {
  id              String   @id @default(cuid())
  workspaceId     String   @map("workspace_id")
  name            String
  providerVoiceId String   @map("provider_voice_id")
  /// When and by whom "this is my own voice and I agree" was confirmed
  consentAt       DateTime @map("consent_at")
  consentByUserId String   @map("consent_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  videos    VideoRecording[]

  @@index([workspaceId])
  @@map("voice_clones")
}

/// A video the customer recorded once for video notes. The greeting in its first introMs is
/// re-spoken per person (in the voice below) with the lips matched; the rest is sent as recorded.
model VideoRecording {
  id              String   @id @default(cuid())
  workspaceId     String   @map("workspace_id")
  name            String
  /// The copied voice that speaks the personalized greeting (null once that voice is deleted)
  voiceId         String?  @map("voice_id")
  /// The compressed video and its still, under VIDEO_DIR (<workspace>/<id>.mp4 / .jpg)
  file            String
  poster          String
  durationMs      Int      @map("duration_ms")
  introMs         Int      @map("intro_ms")
  width           Int
  height          Int
  /// When and by whom "this is me, and I agree to my face and voice being used" was confirmed
  consentAt       DateTime @map("consent_at")
  consentByUserId String   @map("consent_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  voice     VoiceClone? @relation(fields: [voiceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@map("video_recordings")
}

/// Who a workspace's invoices are made out to (owner-edited on the Billing page).
model BillingProfile {
  workspaceId  String   @id @map("workspace_id")
  legalName    String   @map("legal_name")
  email        String
  addressLine1 String   @map("address_line1")
  addressLine2 String?  @map("address_line2")
  city         String
  state        String?
  postalCode   String?  @map("postal_code")
  /// ISO 3166 two-letter code (IN, US …)
  country      String
  /// Indian GST number, when the customer has one (shown on invoices)
  gstin        String?
  updatedAt    DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("billing_profiles")
}

/// Invoices of workspaces that were deleted: tax law requires keeping invoices as issued for
/// years, so they're copied here (with nothing else of the workspace) before it's deleted.
model ArchivedInvoice {
  invoiceNumber   String    @id @map("invoice_number")
  /// The deleted workspace's id and name, for finding it again
  workspaceId     String    @map("workspace_id")
  workspaceName   String    @map("workspace_name")
  credits         Int
  kind            String
  priceCents      Int       @map("price_cents")
  currency        String
  paidAt          DateTime? @map("paid_at")
  method          String?
  paymentRef      String?   @map("payment_ref")
  razorpayOrderId String?   @map("razorpay_order_id")
  /// The invoice as issued (seller, buyer, amounts)
  invoice         Json?
  archivedAt      DateTime  @default(now()) @map("archived_at")

  @@map("archived_invoices")
}

/// Hands out invoice numbers in order (one row, id 1), shared by all workspaces.
model InvoiceCounter {
  id   Int @id @default(1)
  last Int @default(1000)

  @@map("invoice_counter")
}

enum DncKind {
  LINKEDIN
  EMAIL
  PHONE
  DOMAIN
  COMPANY
}

/// The workspace's do-not-contact list: no channel ever contacts these people, domains or companies.
model DoNotContact {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  kind        DncKind
  /// Normalised (profile slug, lowercased email/domain, company key) for matching
  value       String
  /// As it was typed, for showing
  label       String
  note        String?
  addedBy     String?  @map("added_by")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, kind, value])
  @@index([workspaceId, createdAt])
  @@map("do_not_contact")
}

/// One person across every channel (Contacts): their LinkedIn profile, email and phone. LinkedIn
/// leads and email contacts link to it (matched by LinkedIn profile or email address).
model Person {
  id           String   @id @default(cuid())
  workspaceId  String   @map("workspace_id")
  firstName    String?  @map("first_name")
  lastName     String?  @map("last_name")
  company      String?
  title        String?
  location     String?
  /// LinkedIn profile slug (linkedin.com/in/<slug>), lowercased: one contact per profile
  linkedinSlug String?  @map("linkedin_slug")
  linkedinUrl  String?  @map("linkedin_url")
  /// Lowercased: one contact per address
  email        String?
  phone        String?
  photoUrl     String?  @map("photo_url")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leads         Lead[]
  emailContacts EmailContact[]

  @@unique([workspaceId, linkedinSlug])
  @@unique([workspaceId, email])
  @@index([workspaceId, updatedAt])
  @@map("people")
}

enum InvySearchStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

/// An Ask Invy search: the conversation, the criteria the AI made of it, and progress.
model InvySearch {
  id          String           @id @default(cuid())
  workspaceId String           @map("workspace_id")
  userId      String?          @map("user_id")
  title       String
  status      InvySearchStatus @default(QUEUED)
  /// [{ role: "user" | "invy", text, at }]
  messages    Json             @default("[]")
  /// InvyCriteria (from @invytra/shared), once understood
  criteria    Json?
  /// Where the Google search got to: { queries: [{ q, next, done }] , pages }
  cursor      Json?
  /// A short line while it runs ("Checking 34 websites…")
  progress    String?
  /// Invy's summary of the results
  summary     String?
  error       String?
  creditsUsed Int              @default(0) @map("credits_used")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  workspace  Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  businesses InvyBusiness[]

  @@index([workspaceId, updatedAt])
  @@index([status])
  @@map("invy_searches")
}

/// A business found by a search (matching or not), with the evidence checked.
model InvyBusiness {
  id             String   @id @default(cuid())
  searchId       String   @map("search_id")
  workspaceId    String   @map("workspace_id")
  /// Google place id
  placeId        String   @map("place_id")
  name           String
  category       String?
  address        String?
  lat            Float
  lng            Float
  phone          String?
  website        String?
  mapsUrl        String?  @map("maps_url")
  rating         Float?
  reviews        Int?
  businessStatus String?  @map("business_status")
  /// SiteCheck: what was seen on its website
  check          Json?
  emails         String[] @default([])
  match          Boolean  @default(false)
  /// InvyReason[]: verified reasons with their source
  reasons        Json     @default("[]")
  /// Invy's (AI) take: why it's a fit, and what could be offered
  why            String?
  opportunity    String?
  /// Order among the matches shown (1, 2, …); null = not shown
  position       Int?
  /// Its credit was taken (shown once, paid once)
  charged        Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")

  search InvySearch @relation(fields: [searchId], references: [id], onDelete: Cascade)

  @@unique([searchId, placeId])
  @@index([workspaceId, placeId])
  @@map("invy_businesses")
}

/// A business saved from Ask Invy (the workspace's business prospects).
model InvyProspect {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  placeId     String    @map("place_id")
  name        String
  category    String?
  address     String?
  lat         Float
  lng         Float
  phone       String?
  website     String?
  mapsUrl     String?   @map("maps_url")
  email       String?
  /// The business's social profiles ({network, url}[], SocialLink in @invytra/shared)
  socials     Json      @default("[]")
  why         String?
  opportunity String?
  searchId    String?   @map("search_id")
  /// When it was sent to an email list
  emailedAt   DateTime? @map("emailed_at")
  savedAt     DateTime  @default(now()) @map("saved_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, placeId])
  @@map("invy_prospects")
}

/// A workspace's plan (rules in @invytra/shared pricing.ts). Workspace.plan, channels and the
/// monthly allowances are kept in step with it (lib: packages/db/src/subscriptions.ts).
model Subscription {
  workspaceId            String    @id @map("workspace_id")
  /// trial | starter | growth | vip
  plan                   String    @default("trial")
  /// TRIALING | ACTIVE | PAST_DUE (renewal failed, Razorpay retrying) | CANCELLED (ends at period end) | EXPIRED
  status                 String    @default("TRIALING")
  /// monthly | yearly (null on the trial)
  billingCycle           String?   @map("billing_cycle")
  /// Channels the plan includes (ids from PLAN_CHANNELS)
  channels               String[]
  /// Extra sender accounts per channel beyond the one included ({ "linkedin": 2, "email": 3 })
  extraSenders           Json      @default("{}") @map("extra_senders")
  /// VIP: sender accounts per channel, replacing 1 + extra
  customSenders          Json?     @map("custom_senders")
  /// Credits each month
  monthlyCredits         Int       @map("monthly_credits")
  /// What each billing period charges, in cents
  priceCents             Int       @default(0) @map("price_cents")
  currency               String    @default("USD")
  trialStartedAt         DateTime? @map("trial_started_at")
  trialEndsAt            DateTime? @map("trial_ends_at")
  startedAt              DateTime? @map("started_at")
  currentPeriodStart     DateTime? @map("current_period_start")
  /// The next renewal (or the end, when cancelled)
  currentPeriodEnd       DateTime? @map("current_period_end")
  cancelAtPeriodEnd      Boolean   @default(false) @map("cancel_at_period_end")
  /// PAID | PENDING | FAILED (the last renewal's payment)
  paymentStatus          String?   @map("payment_status")
  razorpaySubscriptionId String?   @unique @map("razorpay_subscription_id")
  /// A change that starts at the next renewal (downgrade, fewer senders, other channels)
  pendingChange          Json?     @map("pending_change")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, trialEndsAt])
  @@map("subscriptions")
}

/// Subscription history: every change, payment and status move.
model SubscriptionEvent {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  /// trial_started | subscribed | renewed | upgraded | change_scheduled | change_applied | payment_failed | cancelled | resumed | expired | vip_set
  kind        String
  detail      Json?
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("subscription_events")
}

/// A plan purchase waiting for its payment: a new subscription (Razorpay subscription) or a
/// mid-period upgrade (a one-time Razorpay order for the difference).
model PlanCheckout {
  id                     String    @id @default(cuid())
  workspaceId            String    @map("workspace_id")
  /// SUBSCRIBE | UPGRADE
  kind                   String
  /// The plan choice (PlanChoice) and its price
  choice                 Json
  amountCents            Int       @map("amount_cents")
  razorpaySubscriptionId String?   @unique @map("razorpay_subscription_id")
  razorpayOrderId        String?   @unique @map("razorpay_order_id")
  /// PENDING | DONE | CANCELLED
  status                 String    @default("PENDING")
  requestedBy            String?   @map("requested_by")
  createdAt              DateTime  @default(now()) @map("created_at")
  doneAt                 DateTime? @map("done_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("plan_checkouts")
}

/// Razorpay plans made for each price (Razorpay needs a plan object per amount and period).
model RazorpayPlan {
  /// "<monthly|yearly>-<cents>"
  key       String   @id
  planId    String   @map("plan_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("razorpay_plans")
}

/// A teammate invited by email: the emailed link (only its hash is kept) lets them create their
/// account straight into this workspace. Pending until accepted, cancelled or expired (7 days).
model WorkspaceInvite {
  id          String     @id @default(cuid())
  workspaceId String     @map("workspace_id")
  email       String
  role        MemberRole @default(MEMBER)
  tokenHash   String     @unique @map("token_hash")
  invitedById String?    @map("invited_by_id")
  expiresAt   DateTime   @map("expires_at")
  acceptedAt  DateTime?  @map("accepted_at")
  revokedAt   DateTime?  @map("revoked_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  /// Last time the email went out (resending refreshes the link)
  sentAt      DateTime   @default(now()) @map("sent_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, email])
  @@map("workspace_invites")
}

/// A WhatsApp Business number connected through Meta's Embedded Signup (official Cloud API).
model WhatsappNumber {
  id            String    @id @default(cuid())
  workspaceId   String    @map("workspace_id")
  /// Meta ids: the WhatsApp Business Account and the phone number in it
  wabaId        String    @map("waba_id")
  phoneNumberId String    @unique @map("phone_number_id")
  displayPhone  String    @default("") @map("display_phone")
  verifiedName  String    @default("") @map("verified_name")
  /// Meta's review of the display name (APPROVED, PENDING_REVIEW, DECLINED …)
  nameStatus    String?   @map("name_status")
  /// GREEN / YELLOW / RED / UNKNOWN
  quality       String    @default("UNKNOWN")
  /// TIER_250, TIER_1K … (new people per 24h)
  messagingTier String?   @map("messaging_tier")
  /// CONNECTED, ERROR (see lastError), DISCONNECTED
  status        String    @default("CONNECTED")
  lastError     String?   @map("last_error")
  /// Business token from Embedded Signup, and the number's two-step PIN (both sealed)
  accessToken   String    @map("access_token")
  pin           String    @default("")
  /// Messages are paid from Invytra's Meta credit line
  creditShared  Boolean   @default(false) @map("credit_shared")
  syncedAt      DateTime? @map("synced_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("whatsapp_numbers")
}

/// A message template of a workspace's WhatsApp Business Account (Meta reviews each one).
model WhatsappTemplate {
  id             String   @id @default(cuid())
  workspaceId    String   @map("workspace_id")
  wabaId         String   @map("waba_id")
  metaId         String?  @map("meta_id")
  name           String
  language       String
  category       String
  /// APPROVED, PENDING, REJECTED, PAUSED, DISABLED …
  status         String
  rejectedReason String?  @map("rejected_reason")
  quality        String?
  /// Meta's components (HEADER, BODY, FOOTER, BUTTONS)
  components     Json
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([wabaId, name, language])
  @@index([workspaceId])
  @@map("whatsapp_templates")
}

/// Someone the workspace may message on WhatsApp: their number, tags, variables and consent.
model WhatsappContact {
  id            String    @id @default(cuid())
  workspaceId   String    @map("workspace_id")
  /// Digits with the country code, no "+" (971501234567): also their WhatsApp id
  phone         String
  firstName     String?   @map("first_name")
  lastName      String?   @map("last_name")
  /// The name on their WhatsApp profile (from their messages)
  profileName   String?   @map("profile_name")
  email         String?
  company       String?
  tags          String[]  @default([])
  /// Custom variables: { key: value }
  vars          Json      @default("{}")
  /// IMPORT, MANUAL, INBOUND, LINK (see WA_CONSENT)
  consentSource String?   @map("consent_source")
  consentAt     DateTime? @map("consent_at")
  /// Who confirmed it, for imports and manual adds
  consentBy     String?   @map("consent_by")
  optedOutAt    DateTime? @map("opted_out_at")
  /// Their message ("STOP"), or "Removed by <name>"
  optOutReason  String?   @map("opt_out_reason")
  /// Their last message: free-form replies are allowed for 24 hours after it
  lastInboundAt DateTime? @map("last_inbound_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, phone])
  @@index([workspaceId, createdAt])
  @@map("whatsapp_contacts")
}
