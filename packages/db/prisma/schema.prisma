// Invytra schema.
// Phase 1: multi-tenant. Every tenant table carries workspace_id, and the web app
// always filters by the signed-in user's workspace.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberRole {
  OWNER
  MEMBER
}

/// A customer (company). Everything a customer owns hangs off a workspace.
model Workspace {
  id        String   @id @default(cuid())
  name      String
  plan      String   @default("trial")
  createdAt DateTime @default(now()) @map("created_at")

  members   Membership[]
  accounts  LinkedinAccount[]
  leadLists LeadList[]
  imports   LeadImport[]
  leads     Lead[]
  campaigns Campaign[]

  @@map("workspaces")
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String
  /// bcrypt hash. Never log or return this.
  passwordHash       String    @map("password_hash")
  createdAt          DateTime  @default(now()) @map("created_at")
  lastLoginAt        DateTime? @map("last_login_at")
  /// Sessions signed before this moment are no longer accepted (password change, "sign out everywhere")
  sessionsValidAfter DateTime? @map("sessions_valid_after")

  memberships Membership[]

  @@map("users")
}

model Membership {
  userId      String     @map("user_id")
  workspaceId String     @map("workspace_id")
  role        MemberRole @default(MEMBER)
  createdAt   DateTime   @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
  @@index([workspaceId])
  @@map("memberships")
}

enum AccountStatus {
  ACTIVE
  PAUSED
  NEEDS_ATTENTION // checkpoint, captcha, restriction or invalid session — a human must look
  DISCONNECTED
}

enum ActionType {
  PROFILE_VISIT
  CONNECTION_REQUEST
  CHECK_CONNECTION
  MESSAGE
  INBOX_SYNC
  /// Reads one page of a LinkedIn / Sales Navigator search into a lead list
  SEARCH_PAGE
  /// Likes the person's most recent post
  LIKE_POST
  /// Withdraws a pending invitation
  WITHDRAW_INVITE
  /// A reply typed by the user in Invytra's inbox
  REPLY
  /// Follows the person's profile
  FOLLOW_PROFILE
  /// Likes and comments on the person's most recent post
  COMMENT_POST
  /// Invites a connection to one of your LinkedIn events
  EVENT_INVITE
}

enum ImportKind {
  LINKEDIN_SEARCH
  SALES_NAV_SEARCH
  SALES_NAV_LIST
}

enum ImportStatus {
  RUNNING
  DONE
  FAILED
  CANCELLED
}

enum ActionStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED // blocked by limits/hours and not retried
}

model LinkedinAccount {
  id               String        @id @default(cuid())
  /// Accounts from .env (Phase 0 CLI) live in the "default" workspace.
  workspaceId      String        @default("default") @map("workspace_id")
  label            String
  email            String?
  proxyUrl         String        @map("proxy_url")
  timezone         String        @default("Asia/Kolkata")
  status           AccountStatus @default(ACTIVE)
  /// AES-256-GCM encrypted Playwright storage state. Never log this.
  encryptedSession Bytes?        @map("encrypted_session")
  sessionUpdatedAt DateTime?     @map("session_updated_at")
  /// { days: number[], startHour: number, endHour: number } — validated by @invytra/shared
  workingHours     Json          @map("working_hours")
  /// Limits object — validated by @invytra/shared limitsSchema
  limits           Json
  statusReason     String?       @map("status_reason")
  lastActiveAt     DateTime?     @map("last_active_at")
  /// Read from LinkedIn after connecting (the person's display name and profile link)
  profileName      String?       @map("profile_name")
  profileUrl       String?       @map("profile_url")
  /// Whether this LinkedIn account has Premium, as last detected (null = not known yet)
  premium          Boolean?
  premiumCheckedAt DateTime?     @map("premium_checked_at")
  /// Not used (the plan is always detected); kept so older data still loads
  premiumOverride  Boolean?      @map("premium_override")
  /// First successful connection through the dashboard or CLI
  connectedAt      DateTime?     @map("connected_at")
  /// Daily limits ramp up until this time (new accounts); null = no warm-up
  warmupUntil      DateTime?     @map("warmup_until")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actions         Action[]
  messages        InboxMessage[]
  campaignSenders CampaignSender[]
  campaignLeads   CampaignLead[]
  imports         LeadImport[]
  conversations   Conversation[]

  @@unique([workspaceId, label])
  @@index([workspaceId])
  @@map("linkedin_accounts")
}

model Action {
  id             String       @id @default(cuid())
  accountId      String       @map("account_id")
  type           ActionType
  targetUrl      String?      @map("target_url")
  /// Action input, e.g. { note } for invites or { text } for messages
  payload        Json?
  status         ActionStatus @default(QUEUED)
  error          String?
  screenshotPath String?      @map("screenshot_path")
  attempts       Int          @default(0)
  scheduledAt    DateTime     @default(now()) @map("scheduled_at")
  executedAt     DateTime?    @map("executed_at")
  durationMs     Int?         @map("duration_ms")
  createdAt      DateTime     @default(now()) @map("created_at")
  /// Set when a campaign queued this action for one of its leads
  campaignLeadId String?      @map("campaign_lead_id")
  /// For a REPLY: the inbox message it answers (older replies)
  inboxMessageId String?      @map("inbox_message_id")
  /// For a REPLY: the conversation it's sent in
  conversationId String?      @map("conversation_id")

  account      LinkedinAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  campaignLead CampaignLead?   @relation(fields: [campaignLeadId], references: [id], onDelete: SetNull)
  inboxMessage InboxMessage?   @relation(fields: [inboxMessageId], references: [id], onDelete: SetNull)
  conversation Conversation?   @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  // Daily/weekly limit counting: actions per account, type and time window
  @@index([accountId, type, status, executedAt])
  @@index([status, scheduledAt])
  // Lead status: what happened to a profile
  @@index([targetUrl])
  @@index([campaignLeadId])
  @@index([inboxMessageId])
  @@index([conversationId])
  @@map("actions")
}

/// Replies fetched by INBOX_SYNC. Deduplicated per account by LinkedIn message id.
model InboxMessage {
  id                String    @id @default(cuid())
  accountId         String    @map("account_id")
  linkedinMessageId String    @map("linkedin_message_id")
  fromName          String    @map("from_name")
  fromProfileUrl    String?   @map("from_profile_url")
  text              String
  sentAt            DateTime  @map("sent_at")
  fetchedAt         DateTime  @default(now()) @map("fetched_at")
  /// The campaign lead this reply is from (matched by name; LinkedIn's inbox list has no profile links)
  campaignLeadId    String?   @map("campaign_lead_id")
  /// Marked handled in Invytra
  doneAt            DateTime? @map("done_at")
  /// A later inbox read showed our own message as the latest in that conversation
  answeredAt        DateTime? @map("answered_at")

  account      LinkedinAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  campaignLead CampaignLead?   @relation(fields: [campaignLeadId], references: [id], onDelete: SetNull)
  /// Replies sent from Invytra's inbox
  replies      Action[]

  @@unique([accountId, linkedinMessageId])
  @@index([accountId, sentAt])
  @@index([accountId, fetchedAt])
  @@index([campaignLeadId])
  @@map("inbox_messages")
}

/// A named list of people to reach out to (CSV upload or pasted links).
model LeadList {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leads     Lead[]
  campaigns Campaign[]
  imports   LeadImport[]

  @@index([workspaceId])
  @@map("lead_lists")
}

/// One person in a list. profileUrl is canonical (https://www.linkedin.com/in/<slug>/),
/// the same form the worker stores in actions.target_url.
model Lead {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  listId      String   @map("list_id")
  profileUrl  String   @map("profile_url")
  firstName   String?  @map("first_name")
  lastName    String?  @map("last_name")
  company     String?
  title       String?
  location    String?
  /// Connection degree seen on LinkedIn (1, 2, 3 = 3rd+), from a search import or a profile visit
  degree      Int?
  /// LinkedIn Premium badge seen (null = not known yet)
  premium     Boolean?
  /// Other columns from the uploaded file, for personalisation later
  extra       Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  list          LeadList       @relation(fields: [listId], references: [id], onDelete: Cascade)
  campaignLeads CampaignLead[]

  @@unique([listId, profileUrl])
  @@index([workspaceId, profileUrl])
  @@index([listId, createdAt])
  @@map("leads")
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum CampaignLeadState {
  QUEUED
  IN_PROGRESS
  WAITING_ACCEPT
  DONE
  REPLIED
  NOT_ACCEPTED
  SKIPPED
  FAILED
  /// Paused by you (e.g. you took over the conversation); reason holds the state to resume to
  PAUSED
}

/// One LinkedIn account working through one lead list with a sequence of steps.
model Campaign {
  id            String         @id @default(cuid())
  workspaceId   String         @map("workspace_id")
  name          String
  /// Leads added to this list later join the running campaign.
  listId        String?        @map("list_id")
  status        CampaignStatus @default(DRAFT)
  /// CampaignStep[] — validated by @invytra/shared sequenceSchema
  steps         Json
  /// CampaignSettings — @invytra/shared campaignSettingsSchema
  settings      Json           @default("{}")
  startedAt     DateTime?      @map("started_at")
  /// Last time leads were copied in from the list (re-copied when the list changes)
  leadsSyncedAt DateTime?      @map("leads_synced_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  list      LeadList?        @relation(fields: [listId], references: [id], onDelete: SetNull)
  leads     CampaignLead[]
  /// The LinkedIn accounts sending for this campaign. Leads are shared out between them.
  senders   CampaignSender[]

  @@index([workspaceId])
  @@index([status])
  @@map("campaigns")
}

/// One person's progress through a campaign. Lead details are copied in, so
/// deleting the list doesn't break a running campaign.
model CampaignLead {
  id           String            @id @default(cuid())
  campaignId   String            @map("campaign_id")
  workspaceId  String            @map("workspace_id")
  leadId       String?           @map("lead_id")
  /// The sender this lead belongs to for its whole journey (a LinkedIn connection is per account).
  /// Assigned when the lead starts; null until then, or if that account was deleted.
  accountId    String?           @map("account_id")
  profileUrl   String            @map("profile_url")
  firstName    String?           @map("first_name")
  lastName     String?           @map("last_name")
  company      String?
  title        String?
  /// The name LinkedIn shows — used to match replies in the inbox
  linkedinName String?           @map("linkedin_name")
  /// Connection degree (1, 2, 3 = 3rd+) and Premium badge, as last seen; used by the campaign's audience settings
  degree       Int?
  premium      Boolean?
  state        CampaignLeadState @default(QUEUED)
  /// Index of the next step to run
  step         Int               @default(0)
  nextAt       DateTime?         @map("next_at")
  /// The queued/running action for this lead, if any
  actionId     String?           @map("action_id")
  /// Why it was skipped / failed / not accepted (a code the dashboard explains)
  reason       String?
  invitedAt    DateTime?         @map("invited_at")
  connectedAt  DateTime?         @map("connected_at")
  /// First message sent by this campaign
  messagedAt   DateTime?         @map("messaged_at")
  repliedAt    DateTime?         @map("replied_at")
  lastActionAt DateTime?         @map("last_action_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  campaign Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead     Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  actions  Action[]
  replies  InboxMessage[]
  account  LinkedinAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  conversations Conversation[]

  @@unique([campaignId, profileUrl])
  @@index([campaignId, state, nextAt])
  @@index([workspaceId, profileUrl])
  @@index([accountId, state])
  @@map("campaign_leads")
}

/// One LinkedIn account sending for one campaign.
model CampaignSender {
  campaignId String   @map("campaign_id")
  accountId  String   @map("account_id")
  createdAt  DateTime @default(now()) @map("created_at")

  campaign Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  account  LinkedinAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([campaignId, accountId])
  @@index([accountId])
  @@map("campaign_senders")
}

/// Collecting people from a LinkedIn or Sales Navigator search into a lead list,
/// one results page per queued SEARCH_PAGE action (CLAUDE.md rule 1).
model LeadImport {
  id          String       @id @default(cuid())
  workspaceId String       @map("workspace_id")
  listId      String       @map("list_id")
  /// The LinkedIn account whose browser reads the search
  accountId   String       @map("account_id")
  kind        ImportKind
  url         String
  status      ImportStatus @default(RUNNING)
  /// Stop after this many people
  maxLeads    Int          @default(500) @map("max_leads")
  /// Next results page to read (1-based)
  nextPage    Int          @default(1) @map("next_page")
  pages       Int          @default(0)
  /// People seen on the pages read so far, and how many were new to the list
  found       Int          @default(0)
  added       Int          @default(0)
  /// The queued/running SEARCH_PAGE action, if any
  actionId    String?      @map("action_id")
  /// Why it stopped (a code the dashboard explains)
  reason      String?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  finishedAt  DateTime?    @map("finished_at")

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  list      LeadList        @relation(fields: [listId], references: [id], onDelete: Cascade)
  account   LinkedinAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([status])
  @@map("lead_imports")
}

/// One LinkedIn conversation of an account, as the inbox shows it. Keyed by the other
/// person's name (LinkedIn's conversation list has no profile links).
model Conversation {
  id              String    @id @default(cuid())
  accountId       String    @map("account_id")
  participantName String    @map("participant_name")
  /// The campaign lead this is with (matched by name)
  campaignLeadId  String?   @map("campaign_lead_id")
  /// Fingerprint of the latest snippet seen in the conversation list (to spot changes)
  lastSnippetKey  String?   @map("last_snippet_key")
  lastMessageText String    @default("") @map("last_message_text")
  /// The latest message is ours
  lastFromMe      Boolean   @default(false) @map("last_from_me")
  lastMessageAt   DateTime  @default(now()) @map("last_message_at")
  /// LinkedIn showed it as unread at the last inbox check
  unread          Boolean   @default(false)
  /// Marked handled in Invytra (cleared when they write again)
  doneAt          DateTime? @map("done_at")
  tags            String[]  @default([])
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  account      LinkedinAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  campaignLead CampaignLead?         @relation(fields: [campaignLeadId], references: [id], onDelete: SetNull)
  messages     ConversationMessage[]
  replies      Action[]

  @@unique([accountId, participantName])
  @@index([accountId, lastMessageAt])
  @@index([campaignLeadId])
  @@map("conversations")
}

/// One message in a conversation, as read from LinkedIn (or sent from Invytra).
model ConversationMessage {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  fromMe         Boolean  @map("from_me")
  text           String
  /// What LinkedIn showed, e.g. "Oct 18 · 12:15 PM"
  timeLabel      String?  @map("time_label")
  /// Best-known time (parsed from LinkedIn, or when Invytra first saw it)
  sentAt         DateTime @map("sent_at")
  /// Side + text + nth repeat: the same message read twice is stored once
  key            String
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, key])
  @@index([conversationId, sentAt])
  @@map("conversation_messages")
}
