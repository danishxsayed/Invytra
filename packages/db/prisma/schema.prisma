// Invytra schema.
// Phase 1: multi-tenant. Every tenant table carries workspace_id, and the web app
// always filters by the signed-in user's workspace.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberRole {
  OWNER
  MEMBER
}

/// A customer (company). Everything a customer owns hangs off a workspace.
model Workspace {
  id        String   @id @default(cuid())
  name      String
  plan      String   @default("trial")
  createdAt DateTime @default(now()) @map("created_at")

  members  Membership[]
  accounts LinkedinAccount[]

  @@map("workspaces")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  /// bcrypt hash. Never log or return this.
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  lastLoginAt  DateTime? @map("last_login_at")

  memberships Membership[]

  @@map("users")
}

model Membership {
  userId      String     @map("user_id")
  workspaceId String     @map("workspace_id")
  role        MemberRole @default(MEMBER)
  createdAt   DateTime   @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
  @@index([workspaceId])
  @@map("memberships")
}

enum AccountStatus {
  ACTIVE
  PAUSED
  NEEDS_ATTENTION // checkpoint, captcha, restriction or invalid session — a human must look
  DISCONNECTED
}

enum ActionType {
  PROFILE_VISIT
  CONNECTION_REQUEST
  CHECK_CONNECTION
  MESSAGE
  INBOX_SYNC
}

enum ActionStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED // blocked by limits/hours and not retried
}

model LinkedinAccount {
  id                String        @id @default(cuid())
  /// Accounts from .env (Phase 0 CLI) live in the "default" workspace.
  workspaceId       String        @default("default") @map("workspace_id")
  label             String
  email             String?
  proxyUrl          String        @map("proxy_url")
  timezone          String        @default("Asia/Kolkata")
  status            AccountStatus @default(ACTIVE)
  /// AES-256-GCM encrypted Playwright storage state. Never log this.
  encryptedSession  Bytes?        @map("encrypted_session")
  sessionUpdatedAt  DateTime?     @map("session_updated_at")
  /// { days: number[], startHour: number, endHour: number } — validated by @invytra/shared
  workingHours      Json          @map("working_hours")
  /// Limits object — validated by @invytra/shared limitsSchema
  limits            Json
  statusReason      String?       @map("status_reason")
  lastActiveAt      DateTime?     @map("last_active_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actions   Action[]
  messages  InboxMessage[]

  @@unique([workspaceId, label])
  @@index([workspaceId])
  @@map("linkedin_accounts")
}

model Action {
  id             String       @id @default(cuid())
  accountId      String       @map("account_id")
  type           ActionType
  targetUrl      String?      @map("target_url")
  /// Action input, e.g. { note } for invites or { text } for messages
  payload        Json?
  status         ActionStatus @default(QUEUED)
  error          String?
  screenshotPath String?      @map("screenshot_path")
  attempts       Int          @default(0)
  scheduledAt    DateTime     @default(now()) @map("scheduled_at")
  executedAt     DateTime?    @map("executed_at")
  durationMs     Int?         @map("duration_ms")
  createdAt      DateTime     @default(now()) @map("created_at")

  account LinkedinAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // Daily/weekly limit counting: actions per account, type and time window
  @@index([accountId, type, status, executedAt])
  @@index([status, scheduledAt])
  @@map("actions")
}

/// Replies fetched by INBOX_SYNC. Deduplicated per account by LinkedIn message id.
model InboxMessage {
  id                String   @id @default(cuid())
  accountId         String   @map("account_id")
  linkedinMessageId String   @map("linkedin_message_id")
  fromName          String   @map("from_name")
  fromProfileUrl    String?  @map("from_profile_url")
  text              String
  sentAt            DateTime @map("sent_at")
  fetchedAt         DateTime @default(now()) @map("fetched_at")

  account LinkedinAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, linkedinMessageId])
  @@index([accountId, sentAt])
  @@map("inbox_messages")
}
