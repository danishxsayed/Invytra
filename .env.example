# ---- Core ----
DATABASE_URL="postgresql://invytra:invytra@localhost:5432/invytra?schema=public"
REDIS_URL="redis://localhost:6379"

# 32-byte key, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_ENCRYPTION_KEY=""

# Where failure screenshots are stored
DATA_DIR="./.data"

# Set to "false" to watch the browser while developing
HEADLESS="true"

# DEV ONLY: lets an account run without a proxy (logs in from your own IP).
# Never enable this on a server.
ALLOW_NO_PROXY="false"

# DEV ONLY: run actions outside each account's working hours (daily limits still apply)
IGNORE_WORKING_HOURS="false"

# Live LinkedIn login window in the dashboard (served by the worker)
CONNECT_PORT="3001"
# Dashboard address(es) allowed to open login windows, comma-separated
WEB_ORIGIN="http://localhost:3000"
# Where the dashboard's browser reaches the worker's login window (web app setting)
CONNECT_WS_URL="ws://localhost:3001"

# ---- Phase 0 test accounts (team-owned test accounts only) ----
# Proxy format: http://user:pass@host:port
ACCOUNT_1_LABEL="test-1"
ACCOUNT_1_EMAIL=""
ACCOUNT_1_PROXY_URL=""
ACCOUNT_1_TIMEZONE="Asia/Kolkata"

ACCOUNT_2_LABEL="test-2"
ACCOUNT_2_EMAIL=""
ACCOUNT_2_PROXY_URL=""
ACCOUNT_2_TIMEZONE="Asia/Kolkata"

# Unipile (optional): connect LinkedIn accounts through Unipile's hosted login. Unipile keeps
# the session and gives each account its own IP, so those accounts need no proxy of ours.
# From the Unipile dashboard: the DSN (host:port) and an API access token. Never commit the token.
UNIPILE_DSN=""
UNIPILE_API_KEY=""

# AI personalisation ({aiLine} in notes and messages): one line written from each person's
# LinkedIn profile. OpenAI API key (never commit it); the model is optional.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Subdomains (optional): the website on ROOT_DOMAIN, the workspace hub on app.<ROOT_DOMAIN>,
# each channel on its own (linkedin.<ROOT_DOMAIN> …), one sign-in for all. Leave empty to run
# everything on one address. To try it locally: ROOT_DOMAIN="lvh.me:3000" and
# WEB_ORIGIN="http://app.lvh.me:3000", then open http://app.lvh.me:3000. See docs/CHANNELS.md.
ROOT_DOMAIN=""

# Public address of the app, for links inside emails (unsubscribe). Defaults to WEB_ORIGIN.
# Must be reachable by recipients (https://app.yourdomain.com) once live.
PUBLIC_URL=

# Email verification (Email Outreach → Contacts). Reoon: key from https://emailverifier.reoon.com
# (API section). MillionVerifier is used only when REOON_API_KEY is empty.
REOON_API_KEY=
MILLIONVERIFIER_API_KEY=

# The platform's own emails (password resets). Resend (recommended): an API key from
# https://resend.com/api-keys, and a From address on a domain you verified in Resend.
RESEND_API_KEY=
PLATFORM_EMAIL_FROM="Invytra <no-reply@yourdomain.com>"
# Where replies to platform emails (welcome email) go, e.g. support@yourdomain.com. Optional.
PLATFORM_EMAIL_REPLY_TO=
# …or any mailbox over SMTP instead (used only when RESEND_API_KEY is empty).
PLATFORM_SMTP_HOST=
PLATFORM_SMTP_PORT=465
PLATFORM_SMTP_USER=
PLATFORM_SMTP_PASS=

# Voice notes: copies of customers' voices read a script for each person (ElevenLabs; voice
# copies need a paid ElevenLabs plan). Unset = voice notes are off.
ELEVENLABS_API_KEY=
# Voice model (default eleven_v4_turbo: half the cost of eleven_v4 / eleven_multilingual_v2).
# ELEVENLABS_MODEL=
# ffmpeg converts voice notes to .m4a for LinkedIn (default: "ffmpeg" on the PATH; without it the mp3 is sent).
# FFMPEG_PATH=

# Video notes: the greeting at the start of a recording is lip-synced per person. Also needs
# ELEVENLABS_API_KEY (the greeting is said in the customer's voice) and ffmpeg + ffprobe.
# HeyGen (default): app.heygen.com -> Settings -> API; pay-as-you-go API balance.
HEYGEN_API_KEY=
# precision (default, better faces) or speed (cheaper, rougher).
# HEYGEN_LIPSYNC_MODE=
# Or sync.so instead (Developers -> API keys). With both keys set, LIPSYNC_PROVIDER=heygen|sync picks one.
# SYNC_API_KEY=
# SYNC_MODEL=
# LIPSYNC_PROVIDER=
# Where recordings are kept (default: .data/videos in the repo). On the server, a folder that's backed up.
# VIDEO_DIR=
# FFPROBE_PATH=

# Payments (Razorpay): credit packs now, plans when pricing is final. Test keys start rzp_test_.
# Unset = orders wait for the team (`pnpm credits:add`).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook: in Razorpay → Webhooks, add https://<hub>/api/razorpay/webhook with events order.paid,
# payment.captured, subscription.activated, subscription.charged, subscription.pending,
# subscription.halted, subscription.cancelled and subscription.completed, and put the secret
# you chose here. Plans renew through Razorpay Subscriptions (card, USD): switch on
# Subscriptions and International Payments in Razorpay.
RAZORPAY_WEBHOOK_SECRET=
# Who invoices are from (shown on every invoice).
INVOICE_SELLER_NAME=Crawlers Technologies Pvt Ltd
# INVOICE_SELLER_ADDRESS=
# INVOICE_SELLER_GSTIN=
# INVOICE_SELLER_EMAIL=

# Ask Invy (find businesses on Google Maps). Google Cloud Console -> APIs & Services:
# a server key with "Places API (New)" (keep it secret), and a browser key with "Maps JavaScript API",
# restricted to your site's address (it's visible in the browser, so restrict it).
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
# A Map ID (Google Cloud -> Map Management) for the markers; DEMO_MAP_ID works while testing.
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# WhatsApp (official Cloud API, Meta Embedded Signup). Meta for Developers -> your app:
# App ID and App secret (App settings -> Basic), the Embedded Signup configuration id
# (Facebook Login for Business -> Configurations), a webhook verify token you make up, and
# (Solution Partners only) the extended credit line id so Invytra pays for messages.
# META_APP_ID=
# META_APP_SECRET=
# META_ES_CONFIG_ID=
# META_WEBHOOK_VERIFY_TOKEN=
# META_CREDIT_LINE_ID=
# META_GRAPH_VERSION=v23.0
# Try a channel before it launches, only for these people:
# PREVIEW_CHANNELS=whatsapp
# PREVIEW_EMAILS=you@company.com
