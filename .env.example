# ---- Core ----
DATABASE_URL="postgresql://invytra:invytra@localhost:5432/invytra?schema=public"
REDIS_URL="redis://localhost:6379"

# 32-byte key, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_ENCRYPTION_KEY=""

# Where failure screenshots are stored
DATA_DIR="./.data"

# Set to "false" to watch the browser while developing
HEADLESS="true"

# DEV ONLY: lets an account run without a proxy (logs in from your own IP).
# Never enable this on a server.
ALLOW_NO_PROXY="false"

# DEV ONLY: run actions outside each account's working hours (daily limits still apply)
IGNORE_WORKING_HOURS="false"

# Live LinkedIn login window in the dashboard (served by the worker)
CONNECT_PORT="3001"
# Dashboard address(es) allowed to open login windows, comma-separated
WEB_ORIGIN="http://localhost:3000"
# Where the dashboard's browser reaches the worker's login window (web app setting)
CONNECT_WS_URL="ws://localhost:3001"

# ---- Phase 0 test accounts (team-owned test accounts only) ----
# Proxy format: http://user:pass@host:port
ACCOUNT_1_LABEL="test-1"
ACCOUNT_1_EMAIL=""
ACCOUNT_1_PROXY_URL=""
ACCOUNT_1_TIMEZONE="Asia/Kolkata"

ACCOUNT_2_LABEL="test-2"
ACCOUNT_2_EMAIL=""
ACCOUNT_2_PROXY_URL=""
ACCOUNT_2_TIMEZONE="Asia/Kolkata"

# Unipile (optional): connect LinkedIn accounts through Unipile's hosted login. Unipile keeps
# the session and gives each account its own IP, so those accounts need no proxy of ours.
# From the Unipile dashboard: the DSN (host:port) and an API access token. Never commit the token.
UNIPILE_DSN=""
UNIPILE_API_KEY=""

# AI personalisation ({aiLine} in notes and messages): one line written from each person's
# LinkedIn profile. OpenAI API key (never commit it); the model is optional.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Subdomains (optional): the website on ROOT_DOMAIN, the workspace hub on app.<ROOT_DOMAIN>,
# each channel on its own (linkedin.<ROOT_DOMAIN> …), one sign-in for all. Leave empty to run
# everything on one address. To try it locally: ROOT_DOMAIN="lvh.me:3000" and
# WEB_ORIGIN="http://app.lvh.me:3000", then open http://app.lvh.me:3000. See docs/CHANNELS.md.
ROOT_DOMAIN=""

# Public address of the app, for links inside emails (unsubscribe). Defaults to WEB_ORIGIN.
# Must be reachable by recipients (https://app.yourdomain.com) once live.
PUBLIC_URL=
