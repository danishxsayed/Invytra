# ---- Core ----
DATABASE_URL="postgresql://invytra:invytra@localhost:5432/invytra?schema=public"
REDIS_URL="redis://localhost:6379"

# 32-byte key, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_ENCRYPTION_KEY=""

# Where failure screenshots are stored
DATA_DIR="./.data"

# Set to "false" to watch the browser while developing
HEADLESS="true"

# DEV ONLY: lets an account run without a proxy (logs in from your own IP).
# Never enable this on a server.
ALLOW_NO_PROXY="false"

# ---- Phase 0 test accounts (team-owned test accounts only) ----
# Proxy format: http://user:pass@host:port
ACCOUNT_1_LABEL="test-1"
ACCOUNT_1_EMAIL=""
ACCOUNT_1_PROXY_URL=""
ACCOUNT_1_TIMEZONE="Asia/Kolkata"

ACCOUNT_2_LABEL="test-2"
ACCOUNT_2_EMAIL=""
ACCOUNT_2_PROXY_URL=""
ACCOUNT_2_TIMEZONE="Asia/Kolkata"
