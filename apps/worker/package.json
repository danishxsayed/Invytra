{
  "name": "@invytra/worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "INVYTRA_PACE=0.02 vitest run",
    "browsers:install": "playwright install chromium",
    "account:login": "tsx src/scripts/login.ts",
    "account:check": "tsx src/scripts/check-session.ts",
    "linkedin": "tsx src/scripts/linkedin.ts",
    "account:probe": "tsx src/scripts/probe.ts",
    "account:reactivate": "tsx src/scripts/reactivate.ts"
  },
  "dependencies": {
    "@invytra/db": "workspace:*",
    "@invytra/shared": "workspace:*",
    "dotenv": "16.4.7",
    "ioredis": "5.4.2",
    "playwright": "1.56.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
