{
  "name": "invytra",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @invytra/db generate",
    "db:migrate": "pnpm --filter @invytra/db migrate",
    "db:studio": "pnpm --filter @invytra/db studio",
    "db:deploy": "pnpm --filter @invytra/db migrate:deploy",
    "browsers:install": "pnpm --filter @invytra/worker browsers:install",
    "account:login": "pnpm --filter @invytra/worker account:login",
    "account:check": "pnpm --filter @invytra/worker account:check",
    "linkedin": "pnpm --filter @invytra/worker linkedin",
    "account:probe": "pnpm --filter @invytra/worker account:probe",
    "account:reactivate": "pnpm --filter @invytra/worker account:reactivate",
    "worker": "pnpm --filter @invytra/worker worker",
    "queue": "pnpm --filter @invytra/worker queue",
    "queue:status": "pnpm --filter @invytra/worker queue:status"
  },
  "devDependencies": {
    "turbo": "2.3.3",
    "typescript": "5.7.2"
  }
}
